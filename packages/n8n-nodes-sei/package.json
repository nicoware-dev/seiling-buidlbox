{
  "name": "n8n-nodes-sei",
  "version": "2.0.0",
  "description": "Custom n8n nodes for Sei blockchain integration",
  "keywords": [
    "n8n-community-node-package",
    "sei",
    "blockchain",
    "cosmos",
    "web3",
    "evm",
    "smart-contracts",
    "n8n"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nicoware-dev/n8n-nodes-sei#readme",
  "author": {
    "name": "nicoware-dev",
    "email": ""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicoware-dev/n8n-nodes-sei.git"
  },
  "bugs": {
    "url": "https://github.com/nicoware-dev/n8n-nodes-sei/issues"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow npm",
    "build": "tsc --skipLibCheck && gulp build:all",
    "dev": "tsc --watch",
    "dev:install": "node scripts/dev-install.js",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials",
    "lintfix": "eslint nodes credentials --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SeiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Sei/SeiTxBuilder.node.js",
      "dist/nodes/Sei/SeiTxExecutor.node.js",
      "dist/nodes/Sei/SeiExplorer.node.js",
      "dist/nodes/Sei/SeiDeployContract.node.js",
      "dist/nodes/Sei/SeiCompileContract.node.js",
      "dist/nodes/Sei/Trading/Symphony.node.js",
      "dist/nodes/Sei/Trading/Carbon.node.js",
      "dist/nodes/Sei/Lending/Yei.node.js",
      "dist/nodes/Sei/Lending/Takara.node.js",
      "dist/nodes/Sei/Staking/Silo.node.js",
      "dist/nodes/Sei/Derivatives/Citrex.node.js",
      "dist/nodes/Sei/Bridge/DeBridge.node.js",
      "dist/nodes/Sei/Bridge/LiFi.node.js",
      "dist/nodes/Sei/Utility/DexScreener.node.js",
      "dist/nodes/Sei/Utility/ERC20.node.js",
      "dist/nodes/Sei/Utility/ERC721.node.js"
    ]
  },
  "devDependencies": {
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.11.0",
    "@typescript-eslint/parser": "^7.15.0",
    "chokidar": "^4.0.3",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "ethers": "^6.14.4",
    "lodash": "^4.17.21",
    "solc": "^0.8.26",
    "viem": "^2.23.3",
    "@sei-agent-kit-custom": "workspace:*",
    "symphony-sdk": "^2.1.0",
    "@bancor/carbon-sdk": "^0.0.115-DEV",
    "citrex-sdk": "^1.2.2",
    "@lifi/sdk": "^3.9.2"
  }
}
